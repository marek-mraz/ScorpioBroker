		<compiler-plugin.version>3.15.0</compiler-plugin.version>
		<spotbugs-plugin.version>4.10.3.0</spotbugs-plugin.version>
		<findsecbugs.version>1.14.0</findsecbugs.version>
		<!-- SpotBugs gate temporarily DISABLED by default (re-enable with -Dspotbugs.skip=false).
		     When on, onlyAnalyze restricts it to our own code (eu.neclab.ngsildbroker.*); vendored
		     third-party sources (e.g. com.github.jsonldjava) are not analyzed. -->
		<spotbugs.skip>true</spotbugs.skip>
		<errorprone.version>2.50.0</errorprone.version>
		<nullaway.version>0.13.7</nullaway.version>
		<failsafe.useModulePath>false</failsafe.useModulePath>
		<maven.compiler.release>21</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
		<quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
		<quarkus.platform.version>3.37.3</quarkus.platform.version>
		<surefire-plugin.version>3.5.6</surefire-plugin.version>
		<java.version>21</java.version>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
		<nativeext></nativeext>
	</properties>
	<build>
		<plugins>
			<plugin>
				<groupId>${quarkus.platform.group-id}</groupId>
				<artifactId>quarkus-maven-plugin</artifactId>
				<version>${quarkus.platform.version}</version>
				<extensions>true</extensions>
				<executions>
					<execution>
						<goals>
							<goal>build</goal>
							<goal>generate-code</goal>
							<goal>generate-code-tests</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>${compiler-plugin.version}</version>
				<configuration>
					<!-- Warnings only (no -Werror yet). Excludes the noisy categories that
					     fire on Quarkus/Lombok generated code and serializable DTOs. Ratchet
					     to -Werror per-module once a module is clean. -->
					<compilerArgs>
						<arg>-parameters</arg>
						<arg>-Xlint:all,-processing,-serial,-this-escape</arg>
					</compilerArgs>
				</configuration>
			</plugin>
			<!-- Bytecode-level bug + security analysis. Bound to `verify` and FAILS the build
			     on any finding (failOnError=true). Escape hatch for the quick AAIO measure
			     loop only: `-Dspotbugs.skip=true`. Suppress false positives in
			     spotbugs-exclude.xml rather than disabling globally. -->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>${spotbugs-plugin.version}</version>
				<configuration>
					<effort>Max</effort>
					<threshold>Low</threshold>
					<failOnError>true</failOnError>
					<xmlOutput>true</xmlOutput>
					<!-- Only fail on OUR code. Vendored/third-party packages (com.github.jsonldjava,
					     etc.) are not analyzed, so their findings never break the build. -->
					<onlyAnalyze>eu.neclab.ngsildbroker.-</onlyAnalyze>
					<excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml</excludeFilterFile>
					<plugins>
						<plugin>
							<groupId>com.h3xstream.findsecbugs</groupId>
							<artifactId>findsecbugs-plugin</artifactId>
							<version>${findsecbugs.version}</version>
						</plugin>
					</plugins>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>io.smallrye</groupId>
				<artifactId>jandex-maven-plugin</artifactId>
				<version>3.6.0</version>
				<executions>
					<execution>
						<id>make-index</id>
						<goals>
							<goal>jandex</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>${surefire-plugin.version}</version>
				<configuration>
					<systemPropertyVariables>
						<java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
						<maven.home>${maven.home}</maven.home>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>
